{
  "manifest_version": 3,
  "name": "Omnivault Web Clipper",
  "version": "1.0.0",
  "description": "1-Click local-first article clipper for Omnivault research vault.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to Omnivault"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Clip current webpage to Omnivault"
    }
  }
}
